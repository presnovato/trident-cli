#!/usr/bin/env sh
# Run trident-cli straight from a clone, without installing it.
# Works from any directory (Git Bash, Linux, macOS).
set -e

here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
root=$(CDPATH= cd -- "$here/.." && pwd)

if command -v python3 >/dev/null 2>&1; then
    PY=python3
else
    PY=python
fi

PYTHONUTF8=1
export PYTHONUTF8
PYTHONPATH="$root${PYTHONPATH:+:$PYTHONPATH}"
export PYTHONPATH

exec "$PY" -m trident_cli "$@"
